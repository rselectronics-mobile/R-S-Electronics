rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalogue/offers can be read by visitors.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /offers/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Visitors may submit an enquiry; only signed-in admins can read it.
    match /enquiries/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
